{
	email {$ACME_EMAIL}
	crowdsec {
		api_url http://127.0.0.1:8081
		api_key {$CROWDSEC_BOUNCER_KEY}
	}
}

{$FLUXER_DOMAIN} {
	# JSON access log: read by CrowdSec, and by you (make logs-access).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}

	# Uploads can be up to 512 MB.
	request_body {
		max_size 512MB
	}

	@outsider not remote_ip {$SITE_ALLOW_CIDRS}
	@admin_outsider {
		path /admin /admin/*
		not remote_ip {$ADMIN_ALLOW_CIDRS}
	}

	# Evaluated top to bottom.
	route {
		# Banned IPs get a 403 before anything else happens.
		crowdsec

		# Site allowlist (LAN-only until you open it in .env).
		respond @outsider "Not open yet." 403

		# Admin dashboard only from allowed networks.
		respond @admin_outsider 404

		# Websockets (/gateway, /livekit/*) are proxied automatically and are not
		# subject to idle timeouts. Fluxer sends its own CSP; don't add one here.
		reverse_proxy 127.0.0.1:8080 {
			# Overwrite, never trust, whatever the visitor sent.
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}
}
