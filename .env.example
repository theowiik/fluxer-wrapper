# Copy to .env and fill in, then: make up   (or: docker compose up -d)

# Public hostname (DNS A/AAAA record must point at your public IP).
FLUXER_DOMAIN=chat.example.com

# Email for Let's Encrypt certificate notices (direct mode) and Fluxer web push.
ACME_EMAIL=you@example.com

# Shared key between Caddy and CrowdSec. Generate one with:
#   openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# How traffic reaches this stack:
#   direct – Caddy here owns ports 80/443 and gets its own certificate.
#   behind – another reverse proxy (Nginx Proxy Manager, Traefik, ...) owns
#            80/443, handles HTTPS, and forwards plain HTTP to BEHIND_PORT here.
PROXY_MODE=direct

# behind mode only: the port Caddy listens on for the proxy in front.
BEHIND_PORT=80
# behind mode only: address(es) of the proxy in front. Only these may tell us
# the visitor's IP via X-Forwarded-For. Set it as narrowly as you can, e.g. the
# LXD bridge address 10.171.28.1 when NPM runs on the LXD host.
TRUSTED_PROXIES=private_ranges

# Who can reach the site. Starts LAN-only so nobody else can register before
# you've created the admin account and closed open registration.
# To go public:  make public   (sets 0.0.0.0/0 ::/0)
SITE_ALLOW_CIDRS=private_ranges

# Who can reach /admin. Space-separated CIDRs.
ADMIN_ALLOW_CIDRS=private_ranges

# Where Fluxer's own stack (compose files, .env with its secrets) is installed on
# the host. Must be an absolute path. Back this directory up.
FLUXER_DIR=/opt/fluxer
